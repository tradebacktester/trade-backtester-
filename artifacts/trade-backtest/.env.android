# ── Android build environment ────────────────────────────────────────────────
#
# Copy this file to .env.android.local (git-ignored) and fill in real values.
# The build script (scripts/build-android.sh) sources this file automatically.
#
# REQUIRED
# ─────────
# The Capacitor WebView cannot make relative-URL API calls — it loads
# from https://localhost, not from your Railway domain.  Set this to
# your deployed Railway backend URL so every fetch() goes to the right place.
#
VITE_API_BASE_URL=https://your-app.up.railway.app

# OPTIONAL
# ─────────
# Any other VITE_* env vars your app reads at build time go here.
# VITE_SOME_FEATURE_FLAG=true
